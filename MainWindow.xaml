<Window x:Class="EasyGet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyGet.ViewModels"
        xmlns:views="clr-namespace:EasyGet.Views"
        xmlns:controls="clr-namespace:EasyGet.Controls"
        xmlns:behaviors="clr-namespace:EasyGet.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EasyGet"
        Width="1360" Height="840"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgChromeBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        behaviors:LayoutDiagnostics.IsEnabled="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarValue}"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
            <views:DownloadView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchDownloadViewModel}">
            <views:BatchDownloadView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <Style x:Key="SidebarNavGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SidebarNavLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyStrong}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}"/>
            <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarNavItem" TargetType="RadioButton" BasedOn="{StaticResource NavRadioButton}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                    <Setter Property="Padding" Value="8,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarBadge" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasQueueBadge}" Value="True"/>
                        <Condition Binding="{Binding IsCompactLayout}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBarText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}"/>
            <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Typography.NumeralStyle" Value="Lining"/>
        </Style>
        <Style x:Key="EngineDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEngineReady}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- The title bar owns the full window width, matching the desktop workbench design. -->
        <Border Grid.Row="0"
                Background="{StaticResource BgChromeBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app.png" Width="28" Height="28" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="EasyGet" Margin="8,0,0,0" Style="{StaticResource TextBodyStrong}"
                               VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0" BorderBrush="{StaticResource BorderPrimaryBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="4,0">
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource TextMono}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource WindowControlButton}" ToolTip="最小化"
                            AutomationProperties.Name="最小化" Click="MinimizeButton_Click">
                        <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButton}" ToolTip="最大化或还原"
                            AutomationProperties.Name="最大化或还原" Click="MaximizeButton_Click">
                        <TextBlock Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" ToolTip="关闭"
                            AutomationProperties.Name="关闭" Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource SidebarNavItem}"
                                     Command="{Binding NavigateCommand}" CommandParameter="download"
                                     ToolTip="单个下载" AutomationProperties.Name="单个下载"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE118;" Style="{StaticResource SidebarNavGlyph}"/>
                                <TextBlock Grid.Column="1" Text="单个下载" Margin="12,0,0,0"
                                           Style="{StaticResource SidebarNavLabel}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarNavItem}"
                                     Command="{Binding NavigateCommand}" CommandParameter="batch"
                                     ToolTip="批量下载" AutomationProperties.Name="批量下载"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8FD;" Style="{StaticResource SidebarNavGlyph}"/>
                                <TextBlock Grid.Column="1" Text="批量下载" Margin="12,0,0,0"
                                           Style="{StaticResource SidebarNavLabel}"/>
                                <Border Grid.Column="2" MinWidth="24" Height="20" Padding="8,0" CornerRadius="8"
                                        Style="{StaticResource SidebarBadge}"
                                        Background="{DynamicResource AccentContainerBrush}">
                                    <TextBlock Text="{Binding QueueTaskCount}" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarNavItem}"
                                     Command="{Binding NavigateCommand}" CommandParameter="history"
                                     ToolTip="下载历史" AutomationProperties.Name="下载历史"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE81C;" Style="{StaticResource SidebarNavGlyph}"/>
                                <TextBlock Grid.Column="1" Text="下载历史" Margin="12,0,0,0"
                                           Style="{StaticResource SidebarNavLabel}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SidebarNavItem}"
                                     Command="{Binding NavigateCommand}" CommandParameter="settings"
                                     ToolTip="设置" AutomationProperties.Name="设置"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE713;" Style="{StaticResource SidebarNavGlyph}"/>
                                <TextBlock Grid.Column="1" Text="设置" Margin="12,0,0,0"
                                           Style="{StaticResource SidebarNavLabel}"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource BgPrimaryBrush}">
                <controls:CachedPageHost Page="{Binding CurrentPage}"/>

                <ItemsControl ItemsSource="{Binding Notifications}"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="16,4,16,0" Panel.ZIndex="100">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NotificationItem}">
                            <Grid x:Name="ToastGrid" Width="324" Margin="0,8,0,0"
                                  behaviors:Motion.PageEnter="True"
                                  MouseEnter="ToastCard_MouseEnter" MouseLeave="ToastCard_MouseLeave">
                                <Border x:Name="ToastCard" Background="{StaticResource BgSurfaceHighestBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodyStrong}">
                                                        <Setter Property="Text" Value="任务完成"/>
                                                        <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                            <Setter Property="Text" Value="需要处理"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                            <Setter Property="Text" Value="检测到链接"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" Margin="0,4,0,0"
                                                       Style="{StaticResource TextBody}"
                                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Height="32" Padding="12,4" Margin="8,0,0,0"
                                                Style="{StaticResource SurfaceButton}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Command="{Binding ExecuteActionCommand}"
                                                Content="{Binding ActionLabel}"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Grid.Column="3" Width="32" Height="32" Margin="8,0,0,0"
                                                Style="{StaticResource ToolbarIconButton}"
                                                ToolTip="关闭通知" AutomationProperties.Name="关闭通知"
                                                Command="{Binding CloseCommand}">
                                            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,1,0">
                <Button Height="32" Padding="8,0"
                        Style="{StaticResource SurfaceButton}"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        ToolTip="打开更新与环境设置"
                        AutomationProperties.Name="打开更新与环境设置"
                        Command="{Binding NavigateCommand}" CommandParameter="settings">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Style="{StaticResource EngineDot}"/>
                        <TextBlock Text="{Binding ToolStatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBarText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource BgChromeBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding TaskStatusText}" Style="{StaticResource StatusBarText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding AggregateSpeedText}" Style="{StaticResource StatusBarText}"
                                   Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiskStatusText}" Style="{StaticResource StatusBarText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <Border Width="1" Height="12" Background="{StaticResource BorderPrimaryBrush}" Margin="12,0"/>
                        <TextBlock Text="{Binding EngineVersionText}" Style="{StaticResource StatusBarText}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        <Border Width="1" Height="12" Background="{StaticResource BorderPrimaryBrush}" Margin="12,0"/>
                        <TextBlock Text="{Binding AppVersion}" Style="{StaticResource StatusBarText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

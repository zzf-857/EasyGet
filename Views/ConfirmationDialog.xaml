<Window x:Class="EasyGet.Views.ConfirmationDialog"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle, ElementName=Root}"
        Width="552"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height, Mode=OneTime}"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Border Background="{DynamicResource BgSurfaceBrush}"
                CornerRadius="20"
                Effect="{StaticResource PopupShadow}"/>

        <Border Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderPrimaryBrush}"
                BorderThickness="1"
                CornerRadius="20"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,17,20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" Margin="0,0,12,0" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentContainerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive, ElementName=Root}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorContainerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#xE7BA;" FontSize="{StaticResource IconSizeBody}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive, ElementName=Root}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,1,14,0">
                        <TextBlock Text="{Binding DialogTitle, ElementName=Root}"
                                   Style="{StaticResource TextSection}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="34" Height="34" Padding="0"
                            VerticalAlignment="Top"
                            Style="{StaticResource SurfaceButton}"
                            Click="CancelButton_Click"
                            ToolTip="关闭"
                            AutomationProperties.Name="关闭确认弹窗">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}"/>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="DialogMessageScroller"
                              Grid.Row="1"
                              Margin="70,0,20,18"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding DialogMessage, ElementName=Root}"
                               Style="{StaticResource TextCaption}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="20,14"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button MinWidth="88" Height="34" Margin="0,0,9,0" Padding="14,5"
                                Style="{StaticResource SurfaceButton}"
                                Content="取消"
                                IsCancel="True"
                                IsDefault="True"
                                Click="CancelButton_Click"/>
                        <Button MinWidth="104" Height="34" Padding="14,5"
                                Content="{Binding ConfirmText, ElementName=Root}"
                                IsDefault="False"
                                Click="ConfirmButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive, ElementName=Root}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DestructiveBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

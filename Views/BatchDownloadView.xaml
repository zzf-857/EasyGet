<UserControl x:Class="EasyGet.Views.BatchDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:EasyGet.Behaviors"
             Background="Transparent"
             AllowDrop="True"
             DragOver="UserControl_DragOver"
             DragLeave="UserControl_DragLeave"
             Drop="UserControl_Drop">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="320" MaxWidth="520"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="560"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="批量下载" Style="{StaticResource TextPageTitle}"/>
                    <TextBlock Text="每行一个链接，支持自定义名称，格式：链接 | 自定义名称" Margin="0,4,0,0"
                               Style="{StaticResource TextCaption}"/>
                </StackPanel>

                <TextBox Grid.Row="1" Style="{StaticResource DarkTextBox}"
                         Background="{StaticResource BgInputBrush}"
                         Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}"
                          AcceptsReturn="True" TextWrapping="Wrap" Padding="12,8"
                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource FontFamilyMono}"
                         FontSize="{StaticResource FontSizeBody}" AutomationProperties.Name="批量视频链接"/>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                            <Run Text="每行一个链接 · "/><Run Text="{Binding LinkCount, Mode=OneWay}"/><Run Text=" 个有效链接"/>
                        </TextBlock>
                        <Button Grid.Column="1" Height="32" Padding="12,4"
                                Style="{StaticResource SurfaceButton}" Command="{Binding PasteUrlsCommand}"
                                Content="粘贴剪贴板"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="下载格式" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                            <ComboBox Height="32" Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="清晰度优先" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                            <ComboBox Height="32" Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"/>
                        </StackPanel>
                    </Grid>
                    <Button Height="36" Margin="0,12,0,0" Style="{StaticResource AccentButton}"
                            Command="{Binding StartBatchDownloadCommand}" Content="解析并加入队列"/>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16,0,12"/>
                    <TextBlock Text="播放列表 / 合集" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="32" Style="{StaticResource DarkTextBox}"
                                 Background="{StaticResource BgInputBrush}" Padding="12,4"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="粘贴 YouTube、Bilibili 等播放列表链接"/>
                        <Button Grid.Column="2" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}"
                                Command="{Binding ImportPlaylistCommand}" Content="导入"/>
                    </Grid>
                    <Border Height="40" Margin="0,8,0,0" Background="{StaticResource BgInputBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="也可将 .txt 链接文件拖入此窗口" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Style="{StaticResource TextCaption}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeWE"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      DragIncrement="2"
                      KeyboardIncrement="16"
                      Focusable="True"
                      IsTabStop="True"
                      ToolTip="拖动以调整输入面板宽度"
                      AutomationProperties.Name="调整输入面板宽度">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="Transparent">
                        <Border x:Name="DividerLine" Width="1" HorizontalAlignment="Center"
                                Background="{StaticResource BorderSubtleBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Column="2" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="下载队列" Style="{StaticResource TextSection}"/>
                    <TextBlock Text="{Binding QueueSummaryText}" Margin="0,4,0,0"
                               Style="{StaticResource TextCaption}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding QueueSummaryText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}"
                            Command="{Binding PauseAllCommand}" Content="全部暂停"/>
                    <Button Height="32" Padding="12,4" Margin="8,0,0,0" Style="{StaticResource SurfaceButton}"
                            Command="{Binding ResumeAllCommand}" Content="全部恢复"/>
                    <Button Height="32" Padding="12,4" Margin="8,0,0,0" Style="{StaticResource SurfaceButton}"
                            Command="{Binding RetryFailedCommand}" Content="重试失败"/>
                    <Button x:Name="OverflowButton" Width="32" Height="32" Padding="0" Margin="8,0,0,0"
                            Style="{StaticResource ToolbarIconButton}" ToolTip="更多队列操作"
                            AutomationProperties.Name="更多队列操作" Click="OverflowButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="停止全部未完成任务" Command="{Binding CancelAllCommand}"/>
                                <MenuItem Header="清理已结束任务" Command="{Binding ClearFinishedCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" HorizontalAlignment="Left" Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="全部"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=全部}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="全部"/><TextBlock Text="{Binding TotalTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="进行中"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=进行中}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="进行中"/><TextBlock Text="{Binding RunningTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="等待"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=等待}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="等待"/><TextBlock Text="{Binding WaitingTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="计划"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=计划}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="计划"/><TextBlock Text="{Binding ScheduledTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="已暂停"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=已暂停}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="已暂停"/><TextBlock Text="{Binding PausedTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="失败"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=失败}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="失败"/><TextBlock Text="{Binding FailedTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource HistoryFilterRadioButton}"
                                     Command="{Binding SetQueueFilterCommand}" CommandParameter="已完成"
                                     IsChecked="{Binding SelectedQueueFilter, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=已完成}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="已完成"/><TextBlock Text="{Binding CompletedTaskCount}" Margin="4,0,0,0" Opacity="0.6"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasQueueTasks, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OverallProgressText}" Style="{StaticResource TextMono}" FontSize="{StaticResource FontSizeCaption}"/>
                    <ProgressBar Width="112" Height="4" Margin="8,0,0,0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}"/>
                    <TextBlock Text="{Binding AggregateSpeedText}" Style="{StaticResource TextMono}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleQueueTasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeEmptyState}"
                               Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyQueueFilterText}" Margin="0,12,0,0"
                               Style="{StaticResource TextBodyStrong}" HorizontalAlignment="Center"/>
                    <TextBlock Text="在左侧粘贴链接或导入播放列表即可开始"
                               Margin="0,4,0,0" Style="{StaticResource TextCaption}"/>
                </StackPanel>

                <ListBox x:Name="QueueList" ItemsSource="{Binding VisibleQueueTasks}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="68"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="behaviors:Motion.PageEnter" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                <Grid Margin="8,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Waiting"><Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Resolving"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Merging"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Fill" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Scheduled"><Setter Property="Fill" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Fill" Value="{StaticResource ErrorBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <Border Grid.Column="1" Width="80" Height="45"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource BgSurfaceHighestBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="4" ClipToBounds="True">
                                        <Grid ClipToBounds="True">
                                            <TextBlock Text="&#xEC4F;" Style="{StaticResource IconGlyph}"
                                                       FontSize="{StaticResource IconSizeLarge}"
                                                       Foreground="{StaticResource TextDisabledBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Width="80" Height="45" Source="{Binding ThumbnailUrl}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="2" Margin="0,8,12,8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="等待解析..." IsHitTestVisible="False" Margin="6,2,0,0"
                                                       Foreground="{StaticResource TextDisabledBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodyStrong}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0" Padding="4,0,4,0"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     FontSize="{StaticResource FontSizeBodyStrong}"
                                                     FontWeight="SemiBold"
                                                     ToolTip="点击可自定义修改视频名称">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
                                                        <Setter Property="IsReadOnly" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                                <Setter Property="IsReadOnly" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Resolving">
                                                                <Setter Property="IsReadOnly" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Platform, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Platform, Converter={StaticResource StringToVisibility}}"/>
                                            <TextBlock Text=" · " Style="{StaticResource TextCaption}"
                                                       Visibility="{Binding Platform, Converter={StaticResource StringToVisibility}}"/>
                                            <TextBlock Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Quality, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileSizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Margin="0,4,0,0"
                                                   Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource ErrorBrush}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>
                                    </Grid>

                                    <Grid Grid.Column="3" Margin="0,8,16,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="18"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Scheduled"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Typography.NumeralAlignment="Tabular">
                                            <Run Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text="%"/>
                                        </TextBlock>
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4"
                                                     HorizontalAlignment="Stretch"
                                                     Maximum="100" Value="{Binding Progress}"
                                                     VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Height="32" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.OpenTaskFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" Content="打开位置">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Height="32" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" Content="暂停">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Height="32" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" Content="继续">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Height="32" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" Content="重试">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Height="32" Padding="8,4" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource ErrorBrush}"
                                                behaviors:Motion.AnimateRemove="True"
                                                behaviors:Motion.RemoveCommand="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                behaviors:Motion.RemoveParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                    <Setter Property="Content" Value="取消"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Content" Value="移除"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Content" Value="移除"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Content" Value="移除"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border x:Name="DragDropOverlay" Grid.ColumnSpan="3" Margin="8"
                Background="{StaticResource ScrimHeavyBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2" CornerRadius="8" Opacity="0" Visibility="Collapsed"
                IsHitTestVisible="False" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE78A;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeEmptyState}"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="释放以导入链接文本或 .txt 文件" Margin="0,12,0,0"
                           Style="{StaticResource TextSection}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

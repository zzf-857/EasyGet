<UserControl x:Class="EasyGet.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:EasyGet.Models"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="SettingsNavItem" TargetType="RadioButton" BasedOn="{StaticResource NavRadioButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
        <Style x:Key="SliderValueBadge" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style x:Key="SliderValueText" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStrong}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="RiskSliderValueBadge" TargetType="Border" BasedOn="{StaticResource SliderValueBadge}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warning">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Critical">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RiskSliderValueText" TargetType="TextBlock" BasedOn="{StaticResource SliderValueText}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceRiskPanel" TargetType="Border">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{StaticResource BgSurfaceHighBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warning">
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Critical">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceRiskIndicator" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warning">
                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Critical">
                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PerformanceRiskText" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,16">
                <TextBlock Text="设置" Style="{StaticResource TextPageTitle}" Margin="8,0,0,12"/>

                <RadioButton Style="{StaticResource SettingsNavItem}" Content="常规"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="常规"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=常规}"/>
                <RadioButton Style="{StaticResource SettingsNavItem}" Content="下载"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="下载"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=下载}"/>
                <RadioButton Style="{StaticResource SettingsNavItem}" Content="网络"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="网络"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=网络}"/>
                <RadioButton Style="{StaticResource SettingsNavItem}" Content="账号与 Cookie"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="账号与 Cookie"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=账号与 Cookie}"/>
                <RadioButton Style="{StaticResource SettingsNavItem}" Content="集成"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="集成"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=集成}"/>
                <RadioButton Style="{StaticResource SettingsNavItem}" Content="更新与环境"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="更新与环境"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=更新与环境}"/>
                <RadioButton Style="{StaticResource SettingsNavItem}" Content="数据管理"
                             Command="{Binding SelectCategoryCommand}" CommandParameter="数据管理"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualsToBoolConverter}, ConverterParameter=数据管理}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding SettingsCategoryTitle}" Style="{StaticResource TextSection}"/>
                <TextBlock Text="{Binding SettingsCategoryDescription}" Margin="0,4,0,0" Style="{StaticResource TextCaption}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <Grid MaxWidth="1080" HorizontalAlignment="Left">
                    <!-- General -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=常规}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="主题配色" Style="{StaticResource TextBodyStrong}"/>
                                    <TextBlock Text="用于主操作、选中态和关键进度" Margin="0,4,0,0" Style="{StaticResource TextCaption}"/>
                                </StackPanel>
                                <ListBox Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0"
                                         ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Name"
                                         SelectedValue="{Binding SelectedThemeColor, Mode=TwoWay}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Ring" Width="32" Height="32" CornerRadius="16"
                                                                BorderBrush="Transparent" BorderThickness="2" Padding="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="20" Height="20" Fill="{Binding AccentColor}" ToolTip="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="剪贴板监视" Style="{StaticResource TextBodyStrong}"/>
                                     <TextBlock Text="窗口激活时检测媒体链接并显示解析提示" Margin="0,4,0,0"
                                               Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding ClipboardMonitoringEnabled}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="下载时防止休眠" Style="{StaticResource TextBodyStrong}"/>
                                    <TextBlock Text="存在活动下载时保持 Windows 唤醒，完成后自动恢复" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding PreventSleepDuringDownloads}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="最小化到系统托盘" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="最小化后继续在后台运行下载任务" Margin="0,4,0,0" Style="{StaticResource TextCaption}"/></StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="系统下载通知" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="任务完成或失败时显示系统托盘通知" Margin="0,4,0,0" Style="{StaticResource TextCaption}"/></StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SystemNotificationsEnabled}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Download -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=下载}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="默认保存目录" Style="{StaticResource TextBodyStrong}"/>
                                    <TextBlock Text="{Binding DefaultDownloadPath}" Margin="0,4,0,0" Style="{StaticResource TextMono}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}"
                                        Command="{Binding BrowseDownloadPathCommand}" Content="更改目录"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="默认下载格式" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="新任务默认使用的封装格式" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <ComboBox Grid.Column="1" Width="180" Height="32" HorizontalAlignment="Right" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding DefaultFormat}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="画质上限" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="支持多分辨率的平台将遵循此上限" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <ComboBox Grid.Column="1" Width="180" Height="32" HorizontalAlignment="Right" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding DefaultQuality}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="性能配置建议" Style="{StaticResource TextBodyStrong}"/>
                                        <TextBlock Text="{Binding PerformanceRecommendationText}" Margin="0,4,0,0"
                                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Width="128" Height="32" Padding="10,4"
                                                Style="{StaticResource SurfaceButton}"
                                                Click="ShowPerformanceDetailsButton_Click"
                                                ToolTip="查看性能估算依据、风险区间和实际连接预算"
                                                AutomationProperties.Name="查看详细建议">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                                                <TextBlock Text="查看详细建议" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="128" Height="32" Margin="8,0,0,0" Padding="10,4"
                                                Style="{StaticResource SurfaceButton}"
                                                Command="{Binding ApplyRecommendedPerformanceSettingsCommand}"
                                                ToolTip="自动应用当前设备建议的并发分片和同时任务数"
                                                AutomationProperties.Name="应用推荐配置">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                                                <TextBlock Text="应用推荐配置" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,8,0,0" Tag="{Binding PerformanceRiskLevel}"
                                        Style="{StaticResource PerformanceRiskPanel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Tag="{Binding PerformanceRiskLevel}" Style="{StaticResource PerformanceRiskIndicator}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PerformanceStatusText}" TextWrapping="Wrap"
                                                   Tag="{Binding PerformanceRiskLevel}" Style="{StaticResource PerformanceRiskText}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="并发分片" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="{Binding ConcurrentFragmentsDescriptionText}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <Grid Grid.Column="1" Width="340" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource AccentSlider}"
                                            Minimum="{Binding Source={x:Static models:AppConfig.MinConcurrentFragments}, Mode=OneTime}"
                                            Maximum="{Binding Source={x:Static models:AppConfig.MaxConcurrentFragments}, Mode=OneTime}"
                                            TickFrequency="1" SmallChange="1" LargeChange="1"
                                            Value="{Binding ConcurrentFragments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="并发分片"
                                            AutomationProperties.HelpText="可设置 1 到 32 个分片"/>
                                    <Border Grid.Column="1" Tag="{Binding ConcurrentFragmentsRiskLevel}" Style="{StaticResource RiskSliderValueBadge}">
                                        <TextBlock Text="{Binding ConcurrentFragments, StringFormat={}{0} 分片}"
                                                   Tag="{Binding ConcurrentFragmentsRiskLevel}" Style="{StaticResource RiskSliderValueText}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="同时下载任务数" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="允许 1–12 个任务并行运行" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <Grid Grid.Column="1" Width="340" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource AccentSlider}"
                                            Minimum="{Binding Source={x:Static models:AppConfig.MinConcurrentDownloadLimit}, Mode=OneTime}"
                                            Maximum="{Binding Source={x:Static models:AppConfig.MaxConcurrentDownloadLimit}, Mode=OneTime}"
                                            TickFrequency="1" SmallChange="1" LargeChange="1"
                                            Value="{Binding MaxConcurrentDownloads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="同时下载任务数"
                                            AutomationProperties.HelpText="可设置 1 到 12 个任务"/>
                                    <Border Grid.Column="1" Tag="{Binding ConcurrentDownloadsRiskLevel}" Style="{StaticResource RiskSliderValueBadge}">
                                        <TextBlock Text="{Binding MaxConcurrentDownloads, StringFormat={}{0} 个}"
                                                   Tag="{Binding ConcurrentDownloadsRiskLevel}" Style="{StaticResource RiskSliderValueText}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="全局下载限速" Style="{StaticResource TextBodyStrong}"/>
                                    <TextBlock Text="应用于所有 yt-dlp 下载任务；0 为不限速，最高 1,024 MB/s" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="340" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource AccentSlider}"
                                            Minimum="0"
                                            Maximum="{Binding GlobalDownloadRateLimitSliderMaximum, Mode=OneTime}"
                                            TickFrequency="1" SmallChange="1" LargeChange="1"
                                            AutoToolTipPlacement="None"
                                            Value="{Binding GlobalDownloadRateLimitSliderStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="全局下载限速"
                                            AutomationProperties.HelpText="0 表示不限速，最高 1024 MB 每秒"/>
                                    <Border Grid.Column="1" Style="{StaticResource SliderValueBadge}">
                                        <TextBlock Text="{Binding GlobalDownloadRateLimitDisplayText}" Style="{StaticResource SliderValueText}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="aria2c 外部下载器" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="不可用时自动回退到 yt-dlp" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseAria2c}"/></Grid>
                        </Border>
                    </StackPanel>

                    <!-- Network -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=网络}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="启用网络代理" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="媒体解析与下载请求通过代理访问" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseProxy}"/></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}" IsEnabled="{Binding UseProxy}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="代理地址" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="HTTP、HTTPS 或 SOCKS5 地址" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <TextBox Grid.Column="1" Width="340" Height="32" HorizontalAlignment="Right" VerticalContentAlignment="Center" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="{Binding SettingsSaveStatusMessage}" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Style="{StaticResource TextCaption}" Visibility="{Binding SettingsSaveStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                            <Button Height="32" Padding="16,4" Style="{StaticResource AccentButton}" Command="{Binding SaveSettingsCommand}" Content="保存网络设置"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Accounts and cookies -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=账号与 Cookie}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="智能 Cookie" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="按平台选择系统浏览器或 EasyGet 登录状态" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SmartCookieEnabled}"/></Grid>
                        </Border>
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="平台状态" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="{Binding CookieStatusSummary}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}"
                                    Command="{Binding RefreshCookieStatusCommand}" Content="重新扫描"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CookiePlatformStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="48" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TextBodyStrong}"/>
                                                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Height="32" MinWidth="104" Padding="12,4" CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                            <Setter Property="Content" Value="登录并检测"/>
                                                            <Setter Property="AutomationProperties.Name" Value="登录并检测"/>
                                                            <Setter Property="Command" Value="{Binding DataContext.LoginPlatformCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOperating}" Value="True">
                                                                    <Setter Property="Content" Value="取消检测"/>
                                                                    <Setter Property="AutomationProperties.Name" Value="取消登录检测"/>
                                                                    <Setter Property="Command" Value="{Binding DataContext.CancelPlatformLoginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Height="32" Padding="12,4" Margin="8,0,0,0" Style="{StaticResource SurfaceButton}" Content="兼容登录"
                                                        IsEnabled="{Binding IsOperating, Converter={StaticResource InverseBool}}"
                                                        Command="{Binding DataContext.CompatibleLoginPlatformCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Width="32" Height="32" Padding="0" Margin="8,0,0,0" Style="{StaticResource ToolbarIconButton}"
                                                        IsEnabled="{Binding IsOperating, Converter={StaticResource InverseBool}}"
                                                        ToolTip="清除此平台的 EasyGet 登录数据"
                                                        AutomationProperties.Name="清除此平台的 EasyGet 登录数据"
                                                        Command="{Binding DataContext.ClearPlatformSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}" Foreground="{StaticResource ErrorBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Margin="0,16,0,0">
                            <Expander.Header><TextBlock Text="高级：手动导入 Cookie" Style="{StaticResource TextBodyStrong}"/></Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <ComboBox Height="32" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding CookiePlatformOptions}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="StorageKey" SelectedValue="{Binding LegacyCookiePlatform}"/>
                                <TextBox Height="120" Margin="0,8,0,0" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding CookieContent, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource FontFamilyMono}"/>
                                <TextBlock Text="{Binding ManualCookieValidationMessage}" Margin="0,8,0,0" Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" Visibility="{Binding ManualCookieValidationMessage, Converter={StaticResource StringToVisibility}}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ManualCookieStatusText}" Margin="0,0,16,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,0" Style="{StaticResource AccentButton}"
                                            Command="{Binding SaveSettingsCommand}" Content="加密保存"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Integrations -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=集成}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="Telegram" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="账号绑定状态" Margin="0,4,0,0" Style="{StaticResource TextCaption}"/></StackPanel>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding TgLoginStatusText}" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource TextBodyStrong}"/>
                            </Grid>
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                            <TextBlock Text="API ID" VerticalAlignment="Center" Style="{StaticResource TextBody}"/>
                            <TextBox Grid.Column="1" Height="32" MinWidth="320" Style="{StaticResource DarkTextBox}" Text="{Binding TgApiId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Text="API Hash" VerticalAlignment="Center" Style="{StaticResource TextBody}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Height="32" MinWidth="320" Style="{StaticResource DarkTextBox}" Text="{Binding TgApiHash, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Text="绑定手机号" VerticalAlignment="Center" Style="{StaticResource TextBody}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Height="32" MinWidth="320" Style="{StaticResource DarkTextBox}" Text="{Binding TgPhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0" Visibility="{Binding ShowTgCodeInput, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="验证码" VerticalAlignment="Center" Style="{StaticResource TextBody}"/>
                            <TextBox Grid.Column="1" Height="32" MinWidth="320" Style="{StaticResource DarkTextBox}" Text="{Binding TgVerificationCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0" Visibility="{Binding ShowTgPasswordInput, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="两步验证密码" VerticalAlignment="Center" Style="{StaticResource TextBody}"/>
                            <TextBox Grid.Column="1" Height="32" MinWidth="320" Style="{StaticResource DarkTextBox}" Text="{Binding TgTwoFactorPassword, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Text="{Binding TgStatusMessage}" Margin="0,8,0,0" Style="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding TgStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Height="32" Padding="16,4" Style="{StaticResource AccentButton}" Content="发送验证码"
                                    Command="{Binding SendTgCodeCommand}" Visibility="{Binding ShowTgSendCodeButton, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Height="32" Padding="16,4" Style="{StaticResource AccentButton}" Content="确认验证码"
                                    Command="{Binding SubmitTgCodeCommand}" Visibility="{Binding ShowTgSubmitCodeButton, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Height="32" Padding="16,4" Style="{StaticResource AccentButton}" Content="确认密码"
                                    Command="{Binding SubmitTgPasswordCommand}" Visibility="{Binding ShowTgPasswordInput, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <Expander Margin="0,16,0,0">
                            <Expander.Header><TextBlock Text="绑定指南" Style="{StaticResource TextBodyStrong}"/></Expander.Header>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap">
                                在 <Hyperlink NavigateUri="https://my.telegram.org" RequestNavigate="Hyperlink_RequestNavigate">my.telegram.org</Hyperlink> 创建 API 应用后填入 API ID、API Hash 和带国际区号的手机号,再完成验证码与两步验证。
                            </TextBlock>
                        </Expander>
                    </StackPanel>

                    <!-- Updates and environment -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=更新与环境}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="自动检查更新" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="每天后台检查一次，仅提示，不会自动安装" Margin="0,4,0,0" Style="{StaticResource TextCaption}"/></StackPanel>
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutomaticUpdateChecksEnabled}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="EasyGet" Style="{StaticResource TextBodyStrong}"/><TextBlock Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"><Run Text="{Binding AppVersionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AppRuntimeText, Mode=OneWay}"/></TextBlock></StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}" Command="{Binding CheckAppUpdateCommand}" Content="检查更新"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding AppUpdateStatusMessage}" Margin="0,8,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Visibility="{Binding AppUpdateStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                        <ProgressBar Height="4" Margin="0,8,0,0" Maximum="100" Value="{Binding AppUpdateProgress}" Visibility="{Binding IsDownloadingAppUpdate, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}" Command="{Binding DownloadAppUpdateCommand}" Content="下载更新包" Visibility="{Binding CanDownloadAppUpdate, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Height="32" Padding="12,4" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding InstallAppUpdateCommand}" Content="安装更新" Visibility="{Binding CanInstallAppUpdate, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <Border Style="{StaticResource SettingsRow}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="yt-dlp" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="{Binding YtDlpVersion, FallbackValue='未检测'}" Margin="0,4,0,0" Style="{StaticResource TextMono}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}" Command="{Binding UpdateYtDlpCommand}" IsEnabled="{Binding CanUpdateYtDlp}" Content="更新引擎"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="ffmpeg" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="{Binding FfmpegVersion, FallbackValue='未检测'}" Margin="0,4,0,0" Style="{StaticResource TextMono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FfmpegVersion}"/></StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}" Command="{Binding CheckEnvironmentCommand}" IsEnabled="{Binding CanCheckEnvironment}" Content="重新检测"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="抖音专项组件" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="{Binding DouyinSidecarHealthText}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}" Command="{Binding CheckDouyinSidecarHealthCommand}" Content="检测"/>
                            </Grid>
                        </Border>
                        <Button HorizontalAlignment="Right" Height="32" Padding="16,4" Margin="0,12,0,0"
                                Style="{StaticResource AccentButton}" Command="{Binding InstallMissingToolsCommand}"
                                IsEnabled="{Binding CanInstallMissingTools}" Content="安装缺失组件"/>
                        <TextBlock Text="{Binding InstallStatusStage}" Margin="0,8,0,0" Style="{StaticResource TextCaption}" Visibility="{Binding InstallStatusStage, Converter={StaticResource StringToVisibility}}"/>
                        <TextBlock Text="{Binding InstallStatusMessage}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Visibility="{Binding InstallStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                        <TextBlock Text="{Binding UpdateStatusMessage}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Visibility="{Binding UpdateStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>

                    <!-- Data management -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=数据管理}">
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="用户数据备份" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="备份历史记录、整理文件夹和非敏感设置；不包含 Cookie 与登录凭据" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}" Command="{Binding RestoreDataBackupCommand}" Content="恢复"/>
                                    <Button Height="32" Padding="12,4" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding CreateDataBackupCommand}" Content="创建备份"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="诊断与支持" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="生成脱敏诊断包，用于排查环境、更新和下载失败" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel>
                                <Button Grid.Column="1" Height="32" Padding="12,4" HorizontalAlignment="Right" Style="{StaticResource SurfaceButton}" Command="{Binding CreateSupportBundleCommand}" Content="生成诊断包"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding DataManagementStatusMessage}" Margin="0,8,0,12" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Visibility="{Binding DataManagementStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                        <Border Padding="12,8" Margin="0,0,0,12" Background="{StaticResource ErrorContainerBrush}"
                                BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="这些操作会删除本机数据,执行前将再次确认。" Style="{StaticResource TextBody}" Foreground="{StaticResource ErrorBrush}"/>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="下载历史" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="删除资料库中的全部历史记录,不会删除媒体文件" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource DangerActionButton}" Command="{Binding DataContext.HistoryVM.ClearAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="清空历史"/></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="失效历史记录" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="清理本地文件已不存在的历史记录" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SurfaceButton}" Command="{Binding DataContext.HistoryVM.CleanMissingHistoryRecordsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="扫描并清理"/></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="EasyGet 登录数据" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="清除所有平台的兼容登录与加密 Cookie" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource DangerActionButton}" Command="{Binding ConfirmClearAllManagedSessionsCommand}" Content="清除全部登录"/></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="手动 Cookie" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="移除手动导入并加密保存的 Cookie" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource DangerActionButton}" Command="{Binding ConfirmClearCookieCommand}" Content="清除 Cookie"/></Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="Telegram 会话" Style="{StaticResource TextBodyStrong}"/><TextBlock Text="{Binding TgLoginStatusText}" Margin="0,4,0,0" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource DangerActionButton}" Command="{Binding ConfirmTgLogOutCommand}" Content="移除会话"/></Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

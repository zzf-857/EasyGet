<Window x:Class="EasyGet.Views.ManagedLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Width="840"
        Height="620"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="True"
        AutomationProperties.Name="平台智能登录窗口">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="20,17,20,14">
            <StackPanel>
                <TextBlock Style="{StaticResource TextSection}"
                           Text="{Binding WindowHeading}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Text="{Binding AllowedDomainsText, StringFormat=仅允许访问以下官方域名：{0}}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding AllowedDomainsText}"
                           AutomationProperties.Name="允许读取的登录域名" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="15,13"
                    Background="{DynamicResource AccentContainerBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;"
                               Margin="0,0,9,0"
                               Style="{StaticResource IconGlyph}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="{StaticResource IconSizeBody}" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource TextCaption}"
                               Text="登录在内嵌 WebView2 中完成，凭据通过 Windows 加密后仅保存在本机。"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    MinHeight="260"
                    Margin="0,14"
                    Background="{DynamicResource BgInputBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <wv2:WebView2 x:Name="Browser"
                              AutomationProperties.Name="平台登录网页" />
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Style="{StaticResource TextCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="请在上方网页完成登录，然后点击继续。"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <Border Grid.Row="2"
                Padding="20,14"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        MinWidth="88"
                        Height="34" Padding="14,5"
                        Margin="0,0,9,0"
                        Content="取消"
                        Style="{StaticResource SurfaceButton}"
                        Click="CancelButton_Click"
                        AutomationProperties.Name="取消平台登录" />
                <Button x:Name="ContinueButton"
                        MinWidth="144"
                        Height="34" Padding="14,5"
                        Content="已完成登录，继续"
                        Style="{StaticResource AccentButton}"
                        IsDefault="True"
                        Click="ContinueButton_Click"
                        AutomationProperties.Name="完成登录并继续下载" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

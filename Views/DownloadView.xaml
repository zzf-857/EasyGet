<UserControl x:Class="EasyGet.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="单个下载" Style="{StaticResource TextPageTitle}"/>
            <Border HorizontalAlignment="Right" Height="32" Padding="12,4"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="12"
                    ToolTip="复制视频链接时自动显示解析提示">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SettingsVM.ClipboardMonitoringEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="{StaticResource FontSizeCaption}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                <Setter Property="Text" Value="剪贴板监视"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SettingsVM.ClipboardMonitoringEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Text" Value="剪贴板监视已关闭"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="UrlTextBox" Height="40" Style="{StaticResource DarkTextBox}"
                         Background="{StaticResource BgInputBrush}"
                         Padding="40,4,76,4" VerticalContentAlignment="Center"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RunPrimaryActionCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeBody}"
                           Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock Text="粘贴视频链接后回车解析 — 支持抖音、YouTube、Bilibili、X、TikTok 等平台"
                           Margin="40,0,76,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Url}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Url}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Width="64" Height="32" Margin="0,0,4,0" HorizontalAlignment="Right"
                        Style="{StaticResource SurfaceButton}" Padding="0"
                        Command="{Binding PasteUrlCommand}" ToolTip="粘贴视频链接"
                        AutomationProperties.Name="粘贴视频链接" Content="粘贴"/>
            </Grid>
            <Button Grid.Column="2" Height="40" MinWidth="80" Padding="20,4"
                    Style="{StaticResource AccentButton}" Command="{Binding ParseCommand}"
                    IsEnabled="{Binding CanParse}" AutomationProperties.Name="解析视频链接" Content="解析"/>
        </Grid>

        <Border x:Name="DownloadOptionsPanel" Grid.Row="2" Margin="0,0,0,12"
                Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="6" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="格式" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                        <ComboBox Width="112" Height="32" Margin="8,0,0,0"
                                  Style="{StaticResource DarkComboBox}" ItemsSource="{Binding FormatOptions}"
                                  SelectedItem="{Binding SelectedFormat}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="画质上限" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                        <ComboBox Width="132" Height="32" Margin="8,0,0,0"
                                  Style="{StaticResource DarkComboBox}" ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}"
                                  IsEnabled="{Binding UsesAutomaticSourceFormat}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="字幕" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                        <ComboBox Width="108" Height="32" Margin="8,0,0,0"
                                  Style="{StaticResource DarkComboBox}" ItemsSource="{Binding SubtitleOptions}"
                                  SelectedItem="{Binding SelectedSubtitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="并发" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConcurrentFragmentsText}" Style="{StaticResource TextBody}"
                                    Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextDisabledBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="代理" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProxyStatusText}" Style="{StaticResource TextBody}"
                                    Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="132"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProxyStatusText}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="保存到" Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DownloadDirectory}" Style="{StaticResource TextMono}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DownloadDirectory}"/>
                    <Button Grid.Column="2" Height="32" MinWidth="56" Margin="12,0,0,0" Padding="12,4"
                            Style="{StaticResource SurfaceButton}" Foreground="{DynamicResource AccentBrush}"
                            Background="Transparent" BorderThickness="0"
                            Command="{Binding BrowseDirectoryCommand}" Content="更改"
                            IsEnabled="{Binding CanEditDownloadDestination}"
                            ToolTip="更改下载保存位置" AutomationProperties.Name="更改下载保存位置"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="已有合集" Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <ComboBox Height="32" Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding ExistingCollectionFolders}"
                                  SelectedItem="{Binding SelectedCollectionFolder}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanSelectExistingCollectionFolder}"
                                  ToolTip="{Binding SelectedCollectionFolder.Directory}"
                                  AutomationProperties.Name="选择已有合集文件夹"/>
                        <TextBlock Margin="12,0,32,0" VerticalAlignment="Center"
                                   Text="{Binding ExistingCollectionFolderPlaceholder}"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCollectionFolder}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                            Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding RefreshExistingCollectionFoldersCommand}"
                            IsEnabled="{Binding CanEditDownloadDestination}"
                            ToolTip="刷新已有合集" AutomationProperties.Name="刷新已有合集">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                    </Button>
                    <Button Grid.Column="5" Width="32" Height="32" Padding="0"
                            Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding ClearSelectedCollectionFolderCommand}"
                            IsEnabled="{Binding CanEditDownloadDestination}"
                            ToolTip="取消选择已有合集" AutomationProperties.Name="取消选择已有合集">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizeSmall}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="源流" Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" Height="32" MinWidth="280" MaxWidth="680"
                              HorizontalAlignment="Stretch" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding SourceFormatOptions}"
                              SelectedItem="{Binding SelectedSourceFormat}"
                              IsEnabled="{Binding HasResolvedSourceFormats}"
                              AutomationProperties.Name="选择解析到的真实媒体源流">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" MaxWidth="640"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="定时下载" Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding IsScheduledDownloadEnabled}"
                                  VerticalAlignment="Center" AutomationProperties.Name="启用定时下载"/>
                    <TextBox Grid.Column="2" Width="168" Height="32" Margin="12,0,0,0"
                             VerticalContentAlignment="Center" Style="{StaticResource DarkTextBox}"
                             IsEnabled="{Binding IsScheduledDownloadEnabled}"
                             Text="{Binding ScheduledStartText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="计划开始时间"/>
                    <TextBlock Grid.Column="3" Text="{Binding ScheduleValidationMessage}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                               Visibility="{Binding ScheduleValidationMessage, Converter={StaticResource StringToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- One progressive workspace: state changes never shift the surrounding controls. -->
        <Border Grid.Row="3" Margin="0,0,0,12" MinHeight="190"
                Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderPrimaryBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <Grid Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizePreview}"
                                    Foreground="{StaticResource TextDisabledBrush}"/>
                        <TextBlock Text="粘贴视频链接,回车即可解析" Margin="0,12,0,0"
                                    Style="{StaticResource TextBodyStrong}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="复制链接时会自动弹出提示 · 也可将链接拖到窗口"
                                    Margin="0,4,0,0" Style="{StaticResource TextCaption}"/>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="抖音" Style="{StaticResource TextCaption}"/></Border>
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="YouTube" Style="{StaticResource TextCaption}"/></Border>
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="Bilibili" Style="{StaticResource TextCaption}"/></Border>
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="X / Twitter" Style="{StaticResource TextCaption}"/></Border>
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="TikTok" Style="{StaticResource TextCaption}"/></Border>
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="小红书" Style="{StaticResource TextCaption}"/></Border>
                            <Border BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4,0"><TextBlock Text="1800+ 站点" Style="{StaticResource TextCaption}"/></Border>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            Padding="16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="最近完成" Style="{StaticResource TextCaption}" FontWeight="SemiBold"/>
                            <Button HorizontalAlignment="Right" Height="32" Padding="12,4" Background="Transparent"
                                    BorderThickness="0" Foreground="{DynamicResource AccentBrush}"
                                    Style="{StaticResource SurfaceButton}" Content="查看全部历史"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="history"/>
                            <ListBox Grid.Row="1" Height="96" Margin="0,8,0,0"
                                     Style="{StaticResource DarkListBox}"
                                     ItemsSource="{Binding DataContext.HistoryVM.HistoryItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE73E;" Style="{StaticResource IconGlyph}"
                                                       Foreground="{StaticResource SuccessBrush}" FontSize="{StaticResource IconSizeSmall}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" Style="{StaticResource TextBody}"
                                                       Margin="12,0" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <Button Grid.Column="3" Content="打开位置" Height="32" Padding="8,4"
                                                    Background="Transparent" BorderThickness="0"
                                                    Style="{StaticResource SurfaceButton}" FontSize="{StaticResource FontSizeCaption}"
                                                    Command="{Binding DataContext.HistoryVM.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding AvailableFilePath}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding IsParsing, Converter={StaticResource BoolToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="180" Height="6" IsIndeterminate="True"/>
                    <TextBlock Text="正在解析视频信息" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Style="{StaticResource TextBodyStrong}"/>
                    <TextBlock Text="正在获取封面、标题、时长和预估大小" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Style="{StaticResource TextCaption}"/>
                    <Button Content="取消解析" Margin="0,12,0,0" Height="32" Padding="16,4"
                            Style="{StaticResource SurfaceButton}" Command="{Binding CancelParseCommand}"/>
                </StackPanel>

                <Grid Margin="24" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="244" Height="138" CornerRadius="6" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource BgSurfaceHighestBrush}">
                        <Grid>
                            <Image Source="{Binding PreviewThumbnailUrl}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizePreview}"
                                       Foreground="{StaticResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left" Padding="8,4" CornerRadius="4"
                                    Background="{Binding PreviewPlatform, Converter={StaticResource PlatformToColor}}">
                                <TextBlock Text="{Binding PreviewPlatform}" Style="{StaticResource TextCaption}"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                            <TextBox Text="{Binding CustomFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                     Style="{StaticResource DarkTextBox}" Background="{StaticResource BgInputBrush}"
                                     TextWrapping="Wrap" MaxHeight="64" ToolTip="可自定义保存文件名"
                                     AutomationProperties.Name="自定义视频名称"/>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TextMono}">
                                <Run Text="{Binding PreviewDurationText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PreviewFileSizeText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Row="1" HorizontalAlignment="Right" Height="36" Padding="24,4"
                                Style="{StaticResource AccentButton}" Command="{Binding StartDownloadCommand}"
                                IsEnabled="{Binding CanEditDownloadDestination}"
                                ToolTip="{Binding StartDownloadButtonText}" AutomationProperties.Name="{Binding StartDownloadButtonText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE118;" Style="{StaticResource IconGlyph}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StartDownloadButtonText}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid Margin="24" Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizePreview}"
                                   Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="已加入下载计划" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TextSection}"/>
                        <TextBlock Text="{Binding CurrentTask.DisplayTitle}" Margin="0,4,0,0"
                                   Style="{StaticResource TextBody}" MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentTask.StatusText}" Margin="0,4,0,0"
                                   Style="{StaticResource TextMono}" Foreground="{StaticResource WarningBrush}"/>
                        <Button Height="32" Padding="16,4" Margin="0,16,0,0"
                                Style="{StaticResource SurfaceButton}" Command="{Binding CancelDownloadCommand}"
                                Content="取消计划" ToolTip="取消计划下载" AutomationProperties.Name="取消计划下载"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="24" Visibility="{Binding IsDownloadActive, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="116" Height="66" CornerRadius="6" ClipToBounds="True"
                                Background="{StaticResource BgSurfaceHighestBrush}" HorizontalAlignment="Left">
                            <Image Source="{Binding CurrentTask.ThumbnailUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTask.DisplayTitle, FallbackValue='准备中...'}"
                                       Style="{StaticResource TextBodyStrong}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TextMono}">
                                <Run Text="{Binding CurrentTask.StatusText, Mode=OneWay}"/><Run Text="  ·  "/>
                                <Run Text="{Binding CurrentTask.SpeedText, Mode=OneWay}"/><Run Text="  ·  剩余 "/>
                                <Run Text="{Binding CurrentTask.EtaText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Height="32" Padding="12,4" Style="{StaticResource SurfaceButton}"
                                Command="{Binding CancelDownloadCommand}" Content="取消"
                                ToolTip="取消当前下载" AutomationProperties.Name="取消当前下载"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentTask.Progress, StringFormat={}{0:F1}%}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource TextMono}" Foreground="{DynamicResource AccentBrush}"/>
                        <ProgressBar Grid.Row="1" Height="4" Margin="0,8,0,0" Maximum="100" Value="{Binding CurrentTask.Progress}"/>
                    </Grid>
                </Grid>

                <Grid Margin="24" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizePreview}"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="下载完成" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TextSection}"/>
                        <TextBlock Text="{Binding CurrentTask.DisplayTitle}" Margin="0,4,0,0"
                                   Style="{StaticResource TextBody}" MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentOutputLocationText}" Margin="0,4,0,0"
                                   Style="{StaticResource TextMono}" MaxWidth="680" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Height="32" Padding="16,4" Style="{StaticResource SurfaceButton}"
                                    Command="{Binding OpenCurrentFolderCommand}" Content="打开文件夹"/>
                            <Button Height="32" Padding="16,4" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                                    Command="{Binding PlayCurrentFileCommand}" Content="播放"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Margin="24" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA39;" Style="{StaticResource IconGlyph}" FontSize="{StaticResource IconSizePreview}"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Text="处理失败" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TextSection}"/>
                        <TextBlock Text="{Binding ParseErrorMessage}" Margin="0,4,0,0" MaxWidth="680"
                                   Style="{StaticResource TextBody}" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentErrorMessage}" Margin="0,4,0,0" MaxWidth="680"
                                   Style="{StaticResource TextBody}" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Height="32" Padding="16,4"
                                    Command="{Binding ParseCommand}" Content="重新解析">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTaskFailed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="32" Padding="16,4" Style="{StaticResource AccentButton}"
                                    Command="{Binding RetryCurrentDownloadCommand}" Content="重试下载"
                                    Visibility="{Binding IsTaskFailed, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource BgConsoleBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
            <Expander x:Name="LogExpander" Style="{StaticResource ConsoleExpander}"
                      IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}"
                      Background="Transparent" BorderThickness="0">
                <Expander.Header>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource TextBody}" VerticalAlignment="Center">
                            <Run Text="运行日志"/>
                            <Run Text="  "/>
                            <Run Text="{Binding LogLines.Count, Mode=OneWay}"
                                 FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}"/>
                            <Run Text=" 行" FontSize="{StaticResource FontSizeCaption}"
                                 Foreground="{StaticResource TextMutedBrush}"/>
                        </TextBlock>
                        <Button Grid.Column="1" Height="32" Padding="8,4" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SurfaceButton}" FontSize="{StaticResource FontSizeCaption}" Command="{Binding CopyLogCommand}" Content="复制"
                                ToolTip="复制运行日志" AutomationProperties.Name="复制运行日志"/>
                        <Button Grid.Column="2" Height="32" Padding="8,4" Margin="4,0,8,0" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SurfaceButton}" FontSize="{StaticResource FontSizeCaption}" Command="{Binding ClearLogCommand}" Content="清空"
                                ToolTip="清空运行日志" AutomationProperties.Name="清空运行日志"/>
                    </Grid>
                </Expander.Header>
                <TextBox x:Name="LogTextBox" Height="152" Margin="12,0,12,12"
                         Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextSecondaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeCaption}" Padding="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Expander>
        </Border>
    </Grid>
</UserControl>

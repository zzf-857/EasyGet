<UserControl x:Class="EasyGet.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             HorizontalContentAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="DownloadPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="DownloadFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="DownloadSmallIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="DownloadStatusPill" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource SuccessContainerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="DownloadChip" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{StaticResource BgSurfaceHighBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DownloadViewportScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <Grid Height="{Binding ViewportHeight, ElementName=DownloadViewportScroll}"
              MinHeight="940">
        <Grid Margin="24,22,24,28" MinWidth="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="下载工作台" Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="单个视频下载" Margin="0,4,0,0"
                               Style="{StaticResource TextPageTitle}"/>
                    <TextBlock Text="粘贴链接解析，确认媒体源流与保存位置后开始下载。"
                               Style="{StaticResource TextPageSubtitle}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Border Style="{StaticResource DownloadStatusPill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SettingsVM.YtDlpFound, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                        <Setter Property="Text" Value="yt-dlp 已就绪"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SettingsVM.YtDlpFound, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Text" Value="yt-dlp 未就绪"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DownloadStatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SettingsVM.FfmpegFound, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                        <Setter Property="Text" Value="ffmpeg 已就绪"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.SettingsVM.FfmpegFound, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Text" Value="ffmpeg 未就绪"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.62*" MinWidth="520"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.82*" MinWidth="316"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" x:Name="DownloadOptionsPanel" Style="{StaticResource DownloadPanel}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="视频链接" Style="{StaticResource DownloadFieldLabel}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="UrlTextBox" Height="42"
                                             Style="{StaticResource DarkTextBox}"
                                             Background="{StaticResource BgInputBrush}"
                                             Padding="40,4,12,4" VerticalContentAlignment="Center"
                                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding RunPrimaryActionCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyph}"
                                               FontSize="{StaticResource IconSizeBody}"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="粘贴 YouTube、Bilibili、抖音、X、TikTok 等链接"
                                               Margin="40,0,12,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Url}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Url}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource DownloadSmallIconButton}"
                                        Command="{Binding PasteUrlCommand}"
                                        ToolTip="从剪贴板粘贴视频链接"
                                        AutomationProperties.Name="从剪贴板粘贴视频链接">
                                    <TextBlock Text="&#xE77F;" Style="{StaticResource IconGlyph}"
                                               FontSize="{StaticResource IconSizeSmall}"/>
                                </Button>
                                <Button Grid.Column="4" Height="42" MinWidth="108" Padding="20,4"
                                        Style="{StaticResource AccentButton}" Command="{Binding ParseCommand}"
                                        ToolTip="解析视频链接" AutomationProperties.Name="解析视频链接">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizeSmall}" Margin="0,0,8,0"/>
                                        <TextBlock Text="解析链接"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding UrlError}" Margin="0,6,0,0"
                                       Style="{StaticResource TextCaption}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding UrlError, Converter={StaticResource StringToVisibility}}"/>

                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="封装格式" Style="{StaticResource DownloadFieldLabel}"/>
                                    <ComboBox Height="40" Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding FormatOptions}"
                                              SelectedItem="{Binding SelectedFormat}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="画质上限" Style="{StaticResource DownloadFieldLabel}"/>
                                    <ComboBox Height="40" Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding QualityOptions}"
                                              SelectedItem="{Binding SelectedQuality}"
                                              IsEnabled="{Binding UsesAutomaticSourceFormat}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="字幕" Style="{StaticResource DownloadFieldLabel}"/>
                                    <ComboBox Height="40" Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding SubtitleOptions}"
                                              SelectedItem="{Binding SelectedSubtitle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- One progressive workspace: state changes never shift the surrounding controls. -->
                    <Border Grid.Row="2" MinHeight="370"
                            Style="{StaticResource DownloadPanel}" ClipToBounds="True">
                        <Grid>
                            <Grid Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="32" MaxWidth="620">
                                    <Border Width="60" Height="60" CornerRadius="16"
                                            Background="{StaticResource BgSurfaceHighBrush}">
                                        <TextBlock Text="&#xE71B;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizePreview}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="等待链接" Margin="0,16,0,0"
                                               Style="{StaticResource TextSection}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="支持单个视频、播放列表、m3u8 直链、Telegram 媒体与抖音专用解析通道。剪贴板中出现媒体链接时会自动提示。"
                                               Margin="0,8,0,0" MaxWidth="560"
                                               Style="{StaticResource TextBody}" TextWrapping="Wrap"
                                               TextAlignment="Center" HorizontalAlignment="Center"/>
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Border Style="{StaticResource DownloadChip}"><TextBlock Text="YouTube" Style="{StaticResource TextCaption}"/></Border>
                                        <Border Style="{StaticResource DownloadChip}"><TextBlock Text="Bilibili" Style="{StaticResource TextCaption}"/></Border>
                                        <Border Style="{StaticResource DownloadChip}"><TextBlock Text="抖音" Style="{StaticResource TextCaption}"/></Border>
                                        <Border Style="{StaticResource DownloadChip}"><TextBlock Text="X / Twitter" Style="{StaticResource TextCaption}"/></Border>
                                        <Border Style="{StaticResource DownloadChip}"><TextBlock Text="TikTok" Style="{StaticResource TextCaption}"/></Border>
                                        <Border Style="{StaticResource DownloadChip}"><TextBlock Text="m3u8" Style="{StaticResource TextCaption}"/></Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsParsing, Converter={StaticResource BoolToVisibility}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="60" Height="60" CornerRadius="16"
                                        Background="{DynamicResource AccentContainerBrush}">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"
                                               FontSize="{StaticResource IconSizePreview}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="正在解析媒体信息" Margin="0,16,0,0"
                                           Style="{StaticResource TextSection}"/>
                                <TextBlock Text="正在读取标题、封面、时长与可用源流..."
                                           Margin="0,6,0,0" Style="{StaticResource TextBody}"/>
                                <ProgressBar Width="220" Height="5" Margin="0,18,0,0"
                                             IsIndeterminate="True"/>
                                <Button Content="取消解析" Margin="0,18,0,0" Height="40" Padding="16,4"
                                        Style="{StaticResource SurfaceButton}" Command="{Binding CancelParseCommand}"/>
                            </StackPanel>

                            <Grid Margin="22" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42*" MinWidth="210"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="58*" MinWidth="250"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                                        Background="{StaticResource BgSurfaceHighestBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizeEmptyState}"
                                                   Foreground="{StaticResource TextDisabledBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding PreviewThumbnailUrl}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="12" Padding="9,4" CornerRadius="12"
                                                Background="{Binding PreviewPlatform, Converter={StaticResource PlatformToColor}}">
                                            <TextBlock Text="{Binding PreviewPlatform}"
                                                       Style="{StaticResource TextCaption}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="保存文件名" Style="{StaticResource DownloadFieldLabel}"/>
                                        <TextBox Text="{Binding CustomFileName, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="42" MaxHeight="74"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Background="{StaticResource BgInputBrush}"
                                                 TextWrapping="Wrap"
                                                 ToolTip="可自定义保存文件名"
                                                 AutomationProperties.Name="自定义视频名称"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Padding="12,9" CornerRadius="8"
                                                Background="{StaticResource BgInputBrush}">
                                            <StackPanel>
                                                <TextBlock Text="时长" Style="{StaticResource TextCaption}"/>
                                                <TextBlock Text="{Binding PreviewDurationText}" Margin="0,3,0,0"
                                                           Style="{StaticResource TextMono}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="12,9" CornerRadius="8"
                                                Background="{StaticResource BgInputBrush}">
                                            <StackPanel>
                                                <TextBlock Text="预估大小" Style="{StaticResource TextCaption}"/>
                                                <TextBlock Text="{Binding PreviewFileSizeText}" Margin="0,3,0,0"
                                                           Style="{StaticResource TextMono}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Margin="0,14,0,0"
                                               Text="解析完成，可在右侧确认真实媒体源流与保存位置。"
                                               Style="{StaticResource TextBody}" TextWrapping="Wrap"/>
                                    <Button Grid.Row="3" HorizontalAlignment="Left"
                                            Height="42" MinWidth="142" Padding="20,4"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding StartDownloadCommand}"
                                            IsEnabled="{Binding CanEditDownloadDestination}"
                                            ToolTip="{Binding StartDownloadButtonText}"
                                            AutomationProperties.Name="{Binding StartDownloadButtonText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE118;" Style="{StaticResource IconGlyph}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding StartDownloadButtonText}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>

                            <Grid Margin="28" Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="16"
                                            Background="{StaticResource BgSurfaceHighBrush}">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizePreview}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="已加入下载计划" Margin="0,16,0,0"
                                               Style="{StaticResource TextSection}"/>
                                    <TextBlock Text="{Binding CurrentTask.DisplayTitle}" Margin="0,6,0,0"
                                               Style="{StaticResource TextBody}" MaxWidth="620"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Margin="0,12,0,0" Padding="10,4" CornerRadius="12"
                                            Background="{StaticResource BgSurfaceHighBrush}">
                                        <TextBlock Text="{Binding CurrentTask.StatusText}"
                                                   Style="{StaticResource TextMono}"
                                                   Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                    <Button Height="40" Padding="16,4" Margin="0,18,0,0"
                                            Style="{StaticResource SurfaceButton}"
                                            Command="{Binding CancelDownloadCommand}"
                                            Content="取消计划" ToolTip="取消计划下载"
                                            AutomationProperties.Name="取消计划下载"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="24" Visibility="{Binding IsDownloadActive, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="146"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="130" Height="74" CornerRadius="8" ClipToBounds="True"
                                            Background="{StaticResource BgSurfaceHighestBrush}"
                                            HorizontalAlignment="Left">
                                        <Image Source="{Binding CurrentTask.ThumbnailUrl}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left" Padding="9,3" CornerRadius="12"
                                                Background="{DynamicResource AccentContainerBrush}">
                                            <TextBlock Text="{Binding CurrentTask.StatusText}"
                                                       Style="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CurrentTask.DisplayTitle, FallbackValue='准备中...'}"
                                                   Margin="0,8,0,0" Style="{StaticResource TextBodyStrong}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource TextMono}">
                                            <Run Text="{Binding CurrentTask.SpeedText, Mode=OneWay}"/>
                                            <Run Text="  ·  剩余 "/>
                                            <Run Text="{Binding CurrentTask.EtaText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Height="40" Padding="14,4"
                                            Style="{StaticResource SurfaceButton}"
                                            Command="{Binding CancelDownloadCommand}" Content="取消"
                                            ToolTip="取消当前下载"
                                            AutomationProperties.Name="取消当前下载"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,24,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding CurrentTask.Progress, StringFormat={}{0:F1}%}"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource TextMono}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <ProgressBar Grid.Row="1" Height="6" Margin="0,8,0,0" Maximum="100"
                                                 Style="{StaticResource AccentProgressBar}"
                                                 Value="{Binding CurrentTask.Progress}"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="14,10" CornerRadius="8"
                                            Background="{StaticResource BgInputBrush}">
                                        <StackPanel>
                                            <TextBlock Text="实时速度" Style="{StaticResource TextCaption}"/>
                                            <TextBlock Text="{Binding CurrentTask.SpeedText}" Margin="0,3,0,0"
                                                       Style="{StaticResource TextMono}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="14,10" CornerRadius="8"
                                            Background="{StaticResource BgInputBrush}">
                                        <StackPanel>
                                            <TextBlock Text="预计剩余" Style="{StaticResource TextCaption}"/>
                                            <TextBlock Text="{Binding CurrentTask.EtaText}" Margin="0,3,0,0"
                                                       Style="{StaticResource TextMono}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid Margin="28" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="16"
                                            Background="{StaticResource SuccessContainerBrush}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizePreview}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="下载完成" Margin="0,16,0,0"
                                               Style="{StaticResource TextSection}"/>
                                    <TextBlock Text="{Binding CurrentTask.DisplayTitle}" Margin="0,6,0,0"
                                               Style="{StaticResource TextBody}" MaxWidth="620"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CurrentOutputLocationText}" Margin="0,5,0,0"
                                               Style="{StaticResource TextMono}" MaxWidth="680"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,18,0,0">
                                        <Button Height="40" Padding="16,4"
                                                Style="{StaticResource SurfaceButton}"
                                                Command="{Binding OpenCurrentFolderCommand}"
                                                Content="打开文件夹"/>
                                        <Button Height="40" Padding="16,4" Margin="8,0,0,0"
                                                Style="{StaticResource AccentButton}"
                                                Command="{Binding PlayCurrentFileCommand}" Content="播放"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="28" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="16"
                                            Background="{StaticResource ErrorContainerBrush}">
                                        <TextBlock Text="&#xEA39;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizePreview}"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="处理失败" Margin="0,16,0,0"
                                               Style="{StaticResource TextSection}"/>
                                    <TextBlock Text="{Binding ParseErrorMessage}" Margin="0,6,0,0"
                                               MaxWidth="680" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentErrorMessage}" Margin="0,5,0,0"
                                               MaxWidth="680" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,18,0,0">
                                        <Button Height="40" Padding="16,4"
                                                Command="{Binding ParseCommand}" Content="重新解析">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SurfaceButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTaskFailed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Height="40" Padding="16,4" Margin="8,0,0,0"
                                                Style="{StaticResource AccentButton}"
                                                Command="{Binding RetryCurrentDownloadCommand}"
                                                Content="重试下载"
                                                Visibility="{Binding IsTaskFailed, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource DownloadPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="保存与调度"
                                               Style="{StaticResource TextSection}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="26" Padding="9,0"
                                            CornerRadius="13"
                                            Background="{StaticResource BgSurfaceHighBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="自动保存" Style="{StaticResource TextCaption}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="保存位置" Style="{StaticResource DownloadFieldLabel}"/>
                                        <Grid>
                                            <ComboBox Height="40" Style="{StaticResource DarkComboBox}"
                                                      ItemsSource="{Binding ExistingCollectionFolders}"
                                                      SelectedItem="{Binding SelectedCollectionFolder}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEnabled="{Binding CanEditDownloadDestination}"
                                                      ToolTip="{Binding DownloadDirectory}"
                                                      AutomationProperties.Name="选择保存位置"/>
                                            <TextBlock Margin="12,0,32,0" VerticalAlignment="Center"
                                                       Text="{Binding ExistingCollectionFolderPlaceholder}"
                                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DownloadDirectory}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCollectionFolder}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource DownloadSmallIconButton}"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding BrowseDirectoryCommand}"
                                            IsEnabled="{Binding CanEditDownloadDestination}"
                                            ToolTip="选择新文件夹作为合集"
                                            AutomationProperties.Name="选择新文件夹作为合集">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizeSmall}"/>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            HorizontalAlignment="Right">
                                    <Button Height="34" Padding="10,2" Style="{StaticResource SurfaceButton}"
                                            Command="{Binding ClearSelectedCollectionFolderCommand}"
                                            ToolTip="切换为临时下载"
                                            AutomationProperties.Name="切换为临时下载"
                                            Content="临时下载"/>
                                    <Button Width="34" Height="34" Padding="0" Margin="6,0,0,0"
                                            Style="{StaticResource ToolbarIconButton}"
                                            Command="{Binding RefreshExistingCollectionFoldersCommand}"
                                            IsEnabled="{Binding CanEditDownloadDestination}"
                                            ToolTip="刷新已有合集"
                                            AutomationProperties.Name="刷新已有合集">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"
                                                   FontSize="{StaticResource IconSizeSmall}"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="媒体源流" Style="{StaticResource DownloadFieldLabel}"/>
                                    <ComboBox Height="40" Style="{StaticResource DarkComboBox}"
                                              ItemsSource="{Binding SourceFormatOptions}"
                                              SelectedItem="{Binding SelectedSourceFormat}"
                                              IsEnabled="{Binding HasResolvedSourceFormats}"
                                              AutomationProperties.Name="选择解析到的真实媒体源流">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Border Height="1" Margin="0,18,0,16"
                                        Background="{StaticResource BorderSubtleBrush}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="定时下载" Style="{StaticResource TextBodyStrong}"/>
                                        <TextBlock Text="在指定时间自动开始" Margin="0,2,0,0"
                                                   Style="{StaticResource TextCaption}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding IsScheduledDownloadEnabled}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="启用定时下载"/>
                                </Grid>
                                <TextBox Height="40" Margin="0,12,0,0"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource DarkTextBox}"
                                         IsEnabled="{Binding IsScheduledDownloadEnabled}"
                                         Text="{Binding ScheduledStartText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="计划开始时间"/>
                                <TextBlock Text="{Binding ScheduleValidationMessage}" Margin="0,6,0,0"
                                           Style="{StaticResource TextCaption}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ScheduleValidationMessage, Converter={StaticResource StringToVisibility}}"/>

                                <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="8"
                                        Background="{StaticResource BgInputBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="下载连接" Style="{StaticResource TextCaption}"/>
                                            <TextBlock Text="{Binding ConcurrentFragmentsText}" Margin="0,2,0,0"
                                                       Style="{StaticResource TextBodyStrong}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="代理" Style="{StaticResource TextCaption}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ProxyStatusText}" Margin="0,2,0,0"
                                                       Style="{StaticResource TextBodyStrong}"
                                                       MaxWidth="130" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProxyStatusText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource DownloadPanel}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最近完成" Style="{StaticResource TextSection}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Height="34" Padding="8,2"
                                            Background="Transparent" BorderThickness="0"
                                            Style="{StaticResource SurfaceButton}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Content="查看媒体库"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="history"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" MinHeight="180" Margin="12,4"
                                     Style="{StaticResource DarkListBox}"
                                     ItemsSource="{Binding DataContext.HistoryVM.HistoryItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="56" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="42" Height="34" CornerRadius="6"
                                                    Background="{StaticResource BgSurfaceHighestBrush}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}"
                                                               FontSize="{StaticResource IconSizeSmall}"
                                                               Foreground="{StaticResource TextDisabledBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Title}"
                                                           Style="{StaticResource TextBody}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding FileSizeText}"
                                                           Style="{StaticResource TextBody}"
                                                           VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DownloadTimeText}"
                                                           Margin="8,0,0,0" Style="{StaticResource TextCaption}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Button Grid.Column="2" Width="34" Height="34" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Style="{StaticResource ToolbarIconButton}"
                                                    Command="{Binding DataContext.HistoryVM.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding AvailableFilePath}"
                                                    ToolTip="打开所在文件夹"
                                                    AutomationProperties.Name="打开最近下载所在文件夹">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}"
                                                           FontSize="{StaticResource IconSizeSmall}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2" Background="{StaticResource BgConsoleBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="0,1,0,0">
                                <Expander x:Name="LogExpander"
                                          Style="{StaticResource ConsoleExpander}"
                                          IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0">
                                    <Expander.Header>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource TextBody}"
                                                       VerticalAlignment="Center">
                                                <Run Text="运行日志"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding LogLines.Count, Mode=OneWay}"
                                                     FontSize="{StaticResource FontSizeCaption}"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                                <Run Text=" 行" FontSize="{StaticResource FontSizeCaption}"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>
                                            <Button Grid.Column="1" Height="34" Padding="8,2"
                                                    Background="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SurfaceButton}"
                                                    FontSize="{StaticResource FontSizeCaption}"
                                                    Command="{Binding CopyLogCommand}" Content="复制"
                                                    ToolTip="复制运行日志"
                                                    AutomationProperties.Name="复制运行日志"/>
                                            <Button Grid.Column="2" Height="34" Padding="8,2"
                                                    Margin="4,0,8,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SurfaceButton}"
                                                    FontSize="{StaticResource FontSizeCaption}"
                                                    Command="{Binding ClearLogCommand}" Content="清空"
                                                    ToolTip="清空运行日志"
                                                    AutomationProperties.Name="清空运行日志"/>
                                        </Grid>
                                    </Expander.Header>
                                    <TextBox x:Name="LogTextBox" Height="156" Margin="12,0,12,12"
                                             Text="{Binding LogText, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="NoWrap" Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             FontFamily="{StaticResource FontFamilyMono}"
                                             FontSize="{StaticResource FontSizeCaption}" Padding="0"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
